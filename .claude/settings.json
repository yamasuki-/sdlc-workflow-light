{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sdlc/run\" session_start.py",
            "shell": "bash",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sdlc/run\" guard_write.py",
            "shell": "bash",
            "timeout": 600,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sdlc/run\" guard_bash.py",
            "shell": "bash",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sdlc/run\" guard_skill.py",
            "shell": "bash",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "deny": [
      "Bash(scripts/approve:*)",
      "Bash(./scripts/approve:*)",
      "Bash(python3 scripts/approve:*)"
    ]
  }
}
