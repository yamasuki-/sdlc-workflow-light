#!/usr/bin/env python3
"""SDLC ワークフロー（軽量版）の状態管理 CLI（Claude・人の両方が使う）。

人間ゲートの承認だけはこの CLI ではなく、人が実行する scripts/approve で行う。
使い方は `scripts/sdlc -h` / `scripts/sdlc <コマンド> -h` を参照。
本体は ~/.claude/sdlc/bin またはプロジェクトの .claude/sdlc/bin に置き、プロジェクトの scripts/sdlc（ランチャ）から呼ぶ。
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))  # <.claude>/sdlc/lib

from sdlc_lib import checks, gates, items, project_setup, records, state, testitems, trace  # noqa: E402
from sdlc_lib.shell import find_bash, run_shell  # noqa: E402
from sdlc_lib.config import utf8_stdio  # noqa: E402

utf8_stdio()
from sdlc_lib.config import (PHASE_IDS, PHASES, RESULTS_FILE, ConfigError, body_dirs, find_root,  # noqa: E402
                             gated, install_mode, load_project, phase_id, phase_index, phase_name,
                             project_problems, resolve_body_file)

LAST = PHASE_IDS[-1]
REVIEWED_PHASES = ("01-specification", "02-design", "03-implementation")


def die(msg: str, code: int = 1):
    print(f"エラー: {msg}", file=sys.stderr)
    sys.exit(code)


def ctx():
    root = find_root()
    proj = load_project(root)
    return root, proj


def need_project(proj):
    probs = project_problems(proj)
    if probs:
        die("project.yaml が不完全です（/sdlc-init を実行してください）:\n  - " + "\n  - ".join(probs))


# ------------------------------------------------------------------ status

def open_items(root):
    out = []
    for iid in items.all_ids(root):
        meta, _ = items.load(root, iid)
        if meta.get("status") != "クローズ":
            out.append({"id": iid, "kind": items.kind_of(iid), "status": meta.get("status"), "title": meta.get("title")})
    return out


def compute_status(root, proj):
    st = state.load(root)
    res = {"root": str(root), "state": st, "project_problems": project_problems(proj),
           "gates": [], "open_items": open_items(root),
           "open_questions": records.questions(root, only_open=True), "next": None}
    if res["project_problems"]:
        res["next"] = {"action": "init", "message": "/sdlc-init で project.yaml を作成・補完してください。"}
        return res
    files = gates.list_files(root)
    gs = gates.all_status(root, proj, files)
    res["gates"] = gs
    cur = st["current_phase"]
    k = phase_index(cur)
    g = gs[k]
    skill = PHASES[k]["skill"]

    def nxt(action, message, **kw):
        res["next"] = {"action": action, "phase": cur, "skill": skill, "step": st["step"], "message": message, **kw}
        return res

    if st["mode"] == "item":
        iid = st["item"]
        kind = items.kind_of(iid)
        if cur == st["resume_phase"] and (g["valid"] or (not g["gated"] and st["step"] == "gate")
                                          or phase_index(cur) == len(PHASES) - 1):
            return nxt("item_close", f"{iid}: やり直しが終わりました。テストと再確認（retest）の結果を確かめ、"
                                     f"`scripts/sdlc {kind} close {iid}` で閉じてください。", item=iid, skill=kind)
    elif res["open_items"]:
        d = res["open_items"][0]
        return nxt(d["kind"], f"未完了の{items.LABEL[d['kind']]} {d['id']}（{d['status']}）があります。"
                              f"/{d['kind']} {d['id']} で対応してください。", item=d["id"], skill=d["kind"])
    if not any(Path(root, f).is_file() for f in files if f.startswith("input/") and not f.endswith(".gitkeep")):
        return nxt("need_input", "input/ に要求ドキュメント（xlsx/docx/pptx/pdf/md）を置いてください。")
    bad_up = [s for s in gs[:k] if s["gated"] and not s["valid"]]
    if bad_up:
        u = bad_up[0]
        return nxt("blocked_upstream",
                   f"前工程 {u['phase']} の人間ゲートが無効です（{u['reason']}）。承認後に成果物が変わった場合は"
                   f" /change（仕様の変更）か /defect で扱うか、人が `scripts/approve {u['phase']}` で再承認してください。",
                   upstream=u["phase"])
    if st.get("completed") and st["mode"] == "normal":
        return nxt("done", "全工程が完了しています。")
    if g["gated"]:
        if g["valid"]:
            return nxt("advance", f"{cur} は承認済みです。`scripts/sdlc phase advance` で次へ進みます。")
        if st["step"] == "gate":
            if g["decision"] == "rejected" and g["recorded_hash"] == g["current_hash"]:
                return nxt("revise", f"{cur} は差戻されました（{gate_rel(root, cur)} のコメントを参照）。/{skill} で修正してください。")
            return nxt("await_approval", f"人による承認待ちです。人が端末で `scripts/approve {cur}` を実行してください。")
    elif st["step"] == "gate":
        return nxt("advance", f"{cur} の完了判定です。`scripts/sdlc phase advance`（機械チェックとレビュー判定を確認）で次へ進みます。")
    return nxt("run_phase", f"/{skill} を実行してください（再開位置: {state.STEP_LABELS.get(st['step'], st['step'])}）。")


def gate_rel(root, phase):
    return gates.gate_path(root, phase).relative_to(root).as_posix()


def cmd_status(a):
    root, proj = ctx()
    res = compute_status(root, proj)
    if a.json:
        print(json.dumps(res, ensure_ascii=False, indent=2))
        return
    st = res["state"]
    mode = "通常" if st["mode"] == "normal" else f"{items.label(st['item'])}対応（{st['item']}、戻り先 {st['resume_phase']}）"
    print(f"モード: {mode}")
    print(f"現在工程: {st['current_phase']} {phase_name(st['current_phase'])} / ステップ: "
          f"{state.STEP_LABELS.get(st['step'], st['step'])}" + ("（全工程完了）" if st.get("completed") else ""))
    for p in res["project_problems"]:
        print(f"  ! {p}")
    if res["gates"]:
        print("人間ゲート:")
        for s in res["gates"]:
            mark = "-" if not s["gated"] else ("✔" if s["valid"] else ("·" if not s["exists"] else "✘"))
            print(f"  {mark} {s['phase']:<20} {s['reason']}")
    for d in res["open_items"]:
        print(f"{items.LABEL[d['kind']]}: {d['id']} [{d['status']}] {d['title']}")
    oq = res["open_questions"]
    if oq:
        high = sum(1 for q in oq if q["priority"] == "高")
        print(f"未解決事項: {len(oq)} 件（優先度 高 {high} 件） state/open-questions.md")
    print(f"次のアクション: {res['next']['message']}")


# ------------------------------------------------------------------ init / project

def cmd_init(a):
    root = find_root()
    for d in ["input", "docs", "state/gates", "state/defects", "state/changes"] + [f"docs/{p}" for p in PHASE_IDS]:
        (root / d).mkdir(parents=True, exist_ok=True)
        keep = root / d / ".gitkeep"
        if not any((root / d).iterdir()):
            keep.touch()
    if not state.phase_json(root).exists():
        state.save(root, dict(state.DEFAULT_STATE))
    print("state/ と docs/ を初期化しました。")
    for f in project_setup.write_launchers(root):
        print(f"ランチャを作成しました: {f}")
    line = project_setup.ensure_claude_md(root)
    if line:
        print(f"CLAUDE.md に全体ルールの import を設定しました: {line}")
    for ln in project_setup.ensure_gitignore(root):
        print(f".gitignore に追加しました: {ln}")
    for ln in project_setup.ensure_gitattributes(root):
        print(f".gitattributes に追加しました: {ln}")
    if not (root / "project.yaml").exists():
        tpl = resolve_body_file("templates/project.yaml", root)
        if tpl:
            (root / "project.yaml").write_text(tpl.read_text(encoding="utf-8"), encoding="utf-8")
            print("project.yaml を雛形から作成しました（/sdlc-init で記入してください）。")
    proj = load_project(root)
    for p in project_problems(proj):
        print(f"  ! {p}")


def cmd_path(a):
    """本体のファイルをファイル単位で解決する（プロジェクトの .claude/sdlc → ~/.claude/sdlc）。"""
    root = find_root()
    p = resolve_body_file(a.rel, root)
    if p is None:
        die(f"{a.rel} が見つかりません（探した場所: {', '.join(str(d) for d in body_dirs(root))}）")
    print(p)


def cmd_where(a):
    root = find_root()
    print(f"プロジェクト: {root}")
    print(f"配置: {install_mode(root)}（project = プロジェクトの .claude/、user = ~/.claude/）")
    print(f"実行中の本体: {Path(__file__).resolve().parent.parent}")
    print(f"Python: {sys.executable}（{sys.version.split()[0]}）")
    print(f"bash（テスト・機械チェックの実行に使用）: {find_bash() or '見つかりません'}")
    dirs = body_dirs(root)
    for d in dirs:
        print(f"  {'✔' if d.exists() else '·'} {d}")
    if len(dirs) == 2 and all(d.exists() for d in dirs):
        proj_dir, user_dir = dirs
        shadow = sorted(p.relative_to(proj_dir).as_posix() for p in proj_dir.rglob("*")
                        if p.is_file() and "__pycache__" not in p.parts and (user_dir / p.relative_to(proj_dir)).exists())
        if shadow:
            print("~/.claude/sdlc を上書きしているプロジェクトのファイル:")
            for s in shadow:
                print(f"  {s}")


def cmd_intake(a):
    from intake import convert
    convert.main(a.inputs + (["--out", a.out] if a.out else []))


def cmd_project_check(a):
    _, proj = ctx()
    probs = project_problems(proj)
    if probs:
        die("project.yaml の問題:\n  - " + "\n  - ".join(probs))
    print("project.yaml: OK")
    print(f"人間ゲートを置く工程: {', '.join(proj['gates'])}")
    print(json.dumps({k: v for k, v in proj.items() if k != "gates_raw"}, ensure_ascii=False, indent=2))


# ------------------------------------------------------------------ phase

def cmd_phase_show(a):
    root, _ = ctx()
    print(json.dumps(state.load(root), ensure_ascii=False, indent=2))


def cmd_phase_step(a):
    root, _ = ctx()
    st = state.load(root)
    st["step"] = a.step
    state.save(root, st)
    print(f"{st['current_phase']}: ステップ → {state.STEP_LABELS[a.step]}")


def completion_problems(root, proj, pid) -> list[str]:
    """工程を完了してよいか。人間ゲートのある工程はゲート、無い工程は機械チェックとレビュー判定で決める。"""
    if gated(proj, pid):
        g = gates.gate_status(root, proj, pid)
        return [] if g["valid"] else [f"{pid} の人間ゲートが有効ではありません（{g['reason']}）。"
                                      f"人が `scripts/approve {pid}` を実行する必要があります。"]
    probs = []
    res = checks.run(root, proj, pid)
    if not res["must_passed"]:
        probs.append(f"機械チェック: {checks.summary_line(res)}")
        probs += [f"  [{checks.LEVEL_LABEL[i['level']]}] {i['name']}: " + i["output"].splitlines()[0]
                  for i in res["items"] if i["level"] == "must" and i["status"] == "fail" and i["output"]]
    if pid in REVIEWED_PHASES and not list(Path(root, "docs", pid).glob("*review*.md")):
        probs.append(f"レビュー報告 docs/{pid}/review.md がありません。")
    probs += checks.review_failed(root, pid)
    return probs


def cmd_phase_advance(a):
    root, proj = ctx()
    need_project(proj)
    st = state.load(root)
    cur = st["current_phase"]
    probs = completion_problems(root, proj, cur)
    if probs:
        die(f"{cur} を完了できません:\n  - " + "\n  - ".join(probs))
    k = phase_index(cur)
    if st["mode"] == "item" and cur == st["resume_phase"]:
        die(f"{st['item']} のやり直しは戻り先の {cur} まで終わっています。"
            f"`scripts/sdlc {items.kind_of(st['item'])} close {st['item']}` で閉じてください。")
    if k == len(PHASES) - 1:
        st["completed"], st["step"] = True, "gate"
        state.save(root, st)
        print(f"{cur} を完了しました。全工程が完了です。")
        return
    st["current_phase"], st["step"] = PHASE_IDS[k + 1], "plan"
    state.save(root, st)
    print(f"{cur} を完了しました。工程 → {st['current_phase']} {phase_name(st['current_phase'])}")


# ------------------------------------------------------------------ gate

def cmd_gate_status(a):
    root, proj = ctx()
    need_project(proj)
    phases = [a.phase] if a.phase else PHASE_IDS
    files = gates.list_files(root)
    for p in phases:
        s = gates.gate_status(root, proj, p, files)
        mark = "-" if not s["gated"] else ("✔" if s["valid"] else "✘")
        print(f"{mark} {s['phase']}: {s['reason']}")


def cmd_gate_artifacts(a):
    root, proj = ctx()
    need_project(proj)
    h, its = gates.artifacts(root, proj, a.phase)
    for it in its:
        print(f"{it['sha256'][:12]}  {it['path']}")
    print(f"集約ハッシュ: {h}（{len(its)} ファイル）")


def cmd_gate_check(a):
    """工程 phase に着手してよいか（前の人間ゲートがすべて有効か）。"""
    root, proj = ctx()
    need_project(proj)
    bad = gates.prerequisites(root, proj, a.phase)
    if bad:
        die("前工程の人間ゲートが無効です:\n" + "\n".join(f"  ✘ {s['phase']}: {s['reason']}" for s in bad), 2)
    print(f"{phase_id(a.phase)} に着手できます。")


# ------------------------------------------------------------------ trace

def cmd_trace_check(a):
    root, proj = ctx()
    upto = phase_index(a.upto) if a.upto is not None else phase_index(state.load(root)["current_phase"])
    g = trace.build(root, proj)
    issues = trace.check(g, upto)
    print(f"定義 {len(g.defs)} 件、検査範囲: 工程 {PHASE_IDS[upto]} まで")
    for i in issues:
        print(f"  {i}")
    if issues:
        die(f"トレーサビリティの問題が {len(issues)} 件あります。", 3)
    print("トレーサビリティ: OK")


def cmd_trace_walk(a):
    root, proj = ctx()
    g = trace.build(root, proj)
    unknown = [i for i in a.ids if i not in g.defs]
    if unknown:
        die("未定義の ID: " + ", ".join(unknown))
    if a.cmd2 == "impact":
        print(json.dumps(trace.impact(g, a.ids), ensure_ascii=False, indent=2))
    else:
        for n in trace.upstream(g, a.ids):
            print(f"{n}  {trace.node_file(g, n)}")


def cmd_trace_matrix(a):
    root, proj = ctx()
    out = trace.matrix(trace.build(root, proj), testitems.read_results(root))
    if a.out:
        Path(root, a.out).write_text(out, encoding="utf-8")
        print(f"{a.out} に出力しました。")
    else:
        print(out)


# ------------------------------------------------------------------ check

def writable_evidence(root, proj, phase) -> bool:
    """工程の記録ファイルを書いてよいか（前の人間ゲートが有効で、工程が承認済みでない）。"""
    files = gates.list_files(root)
    if gates.prerequisites(root, proj, phase, files):
        return False
    return not gates.gate_status(root, proj, phase, files)["valid"]


def cmd_check(a):
    root, proj = ctx()
    need_project(proj)
    pid = phase_id(a.phase) if a.phase else state.load(root)["current_phase"]
    res = checks.run(root, proj, pid)
    text = checks.render(res)
    if a.no_report or not writable_evidence(root, proj, pid):
        print(text)
    else:
        p = checks.report_path(root, pid)
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")
        print(f"{p.relative_to(root)} に記録しました。")
    print(f"機械チェック {pid}: {checks.summary_line(res)}")
    sys.exit(0 if res["must_passed"] else 4)


# ------------------------------------------------------------------ testitems

def need_sheet_writable(root, proj):
    if not writable_evidence(root, proj, LAST):
        die(f"{RESULTS_FILE} は今は更新できません（前の人間ゲートが無効、または {LAST} が承認済み）。")


def cmd_ti_sheet(a):
    root, proj = ctx()
    need_project(proj)
    need_sheet_writable(root, proj)
    r = testitems.sync_sheet(root, trace.build(root, proj))
    print(f"{RESULTS_FILE} を更新しました（手動確認 {r['rows']} 件）。"
          + (f" 追加: {', '.join(r['added'])}" if r["added"] else "")
          + (f" 削除: {', '.join(r['removed'])}" if r["removed"] else ""))


def cmd_ti_reset(a):
    root, proj = ctx()
    need_project(proj)
    need_sheet_writable(root, proj)
    tcs, reason = list(a.tcs), a.reason or "再確認"
    if a.item:
        meta, _ = items.load(root, a.item)
        tcs += list(meta.get("retest") or [])
        reason = a.reason or a.item
    if not tcs:
        die("再確認する TC を指定してください（TC-ID か --item）。")
    g = trace.build(root, proj)
    try:
        done = testitems.reset(root, g, sorted(set(tcs)), reason)
    except testitems.ItemsError as e:
        die(str(e))
    skipped = sorted(set(tcs) - set(done))
    print("未実施に戻しました: " + (", ".join(done) or "なし")
          + (f"（手動確認の対象外のため対象外: {', '.join(skipped)}）" if skipped else ""))


def cmd_ti_export(a):
    root, proj = ctx()
    need_project(proj)
    out = Path(root, a.out)
    try:
        n = testitems.export_xlsx(root, trace.build(root, proj), out)
    except testitems.ItemsError as e:
        die(str(e))
    print(f"{out.relative_to(root) if out.is_relative_to(root) else out} に出力しました（手動確認 {n} 件）。"
          "人が黄色の列を記入したら `scripts/sdlc testitems import <ファイル>` で取り込みます。")


def cmd_ti_import(a):
    root, proj = ctx()
    need_project(proj)
    need_sheet_writable(root, proj)
    try:
        r = testitems.import_xlsx(root, trace.build(root, proj), Path(a.file).resolve())
    except testitems.ItemsError as e:
        die(str(e))
    print(f"{RESULTS_FILE} に取り込みました（更新 {len(r['updated'])} 件 / {r['rows']} 件）。"
          + (f" 更新: {', '.join(r['updated'])}" if r["updated"] else ""))


def cmd_ti_report(a):
    root, proj = ctx()
    need_project(proj)
    g = trace.build(root, proj)
    text = testitems.report(root, g)
    if a.write:
        if not writable_evidence(root, proj, LAST):
            die(f"{LAST} は今は更新できません。")
        p = Path(root, "docs", LAST, "report.md")
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")
        print(f"{p.relative_to(root)} に出力しました。")
    else:
        print(text)
    s = testitems.summary(root, g)
    print("集計: " + " / ".join(f"{k} {v}" for k, v in s.items()))


# ------------------------------------------------------------------ decision / question

def cmd_decision(a):
    root, _ = ctx()
    if a.cmd2 == "add":
        did = records.add_decision(root, a.text, a.phase or state.load(root)["current_phase"], a.source)
        print(f"{did} を state/decisions.md に記録しました。")
    else:
        p = records.decisions_path(root)
        print(p.read_text(encoding="utf-8") if p.exists() else "（決定事項なし）")


def cmd_question(a):
    root, _ = ctx()
    if a.cmd2 == "add":
        qid = records.add_question(root, a.text, a.priority, a.phase or state.load(root)["current_phase"], a.source)
        print(f"{qid} を state/open-questions.md に記録しました。")
    elif a.cmd2 == "answer":
        try:
            records.answer_question(root, a.id, a.text, close=not a.keep_open)
        except KeyError as e:
            die(str(e))
        print(f"{a.id} に回答を記録しました。")
    else:
        qs = records.questions(root, only_open=not a.all)
        for q in qs:
            print(f"{q['id']} [{q['status']}] 優先度:{q['priority']} {q['phase'] or ''} {q['text']}")
        if not qs:
            print("（未解決事項なし）")


# ------------------------------------------------------------------ defect / change

def cmd_item_new(a):
    root, _ = ctx()
    st = state.load(root)
    detected = a.detected_in or st["current_phase"]
    try:
        iid = items.create(root, a.kind, a.title, detected, a.severity, list(getattr(a, "tc", None) or []))
    except (ValueError, ConfigError) as e:
        die(str(e))
    print(f"{iid} を起票しました: {items.path(root, iid).relative_to(root)}")


def cmd_item_list(a):
    root, _ = ctx()
    for iid in items.all_ids(root, a.kind):
        m, _ = items.load(root, iid)
        print(f"{iid} [{m.get('status')}] {m.get('severity')} {m.get('title')}（検出: {m.get('detected_in')}）")


def cmd_item_start(a):
    root, proj = ctx()
    need_project(proj)
    if items.kind_of(a.id) != a.kind:
        die(f"{a.id} は{items.label(a.id)}です。`scripts/sdlc {items.kind_of(a.id)} start {a.id}` を使ってください。")
    st = state.load(root)
    if st["mode"] == "item":
        die(f"既に {st['item']} の対応中です（`scripts/sdlc {items.kind_of(st['item'])} close {st['item']}` で閉じてから）。")
    meta, body = items.load(root, a.id)
    if meta.get("status") == "クローズ":
        die(f"{a.id} はクローズ済みです。")
    try:
        start = items.check_start_phase(a.kind, a.from_phase or ("01" if a.kind == "change" else "03"))
    except (ValueError, ConfigError) as e:
        die(str(e))
    resume = st["current_phase"]
    if phase_index(start) > phase_index(resume):
        die(f"やり直しの開始工程 {start} が現在工程 {resume} より後です。")
    rework = items.rework_phases(start, resume)
    when = state.now()
    inv = gates.invalidate(root, proj, rework, a.id, when)
    reset = []
    if meta.get("retest") and testitems.results_path(root).exists():
        try:
            reset = testitems.reset(root, trace.build(root, proj), list(meta["retest"]), a.id)
        except testitems.ItemsError as e:
            die(str(e))
    st.update({"mode": "item", "item": a.id, "resume_phase": resume, "resume_step": st["step"],
               "current_phase": start, "step": "plan", "completed": False})
    state.save(root, st)
    meta["status"], meta["start_phase"] = "対応中", start
    items.save(root, a.id, meta, items.log(body, f"対応開始（やり直し工程 {', '.join(rework)}）"))
    print(f"{items.label(a.id)}対応を開始しました: {a.id} / やり直し工程 {rework} / 戻り先 {resume}")
    for p in inv:
        print(f"  人間ゲートを再承認要にしました: {p}")
    if reset:
        print(f"  再確認のため未実施に戻した TC: {', '.join(reset)}")
    if a.kind == "change" and gated(proj, start):
        print(f"  {start} の成果物を変更したら、人が `scripts/approve {start}` で再承認します。")


def cmd_item_close(a):
    root, proj = ctx()
    need_project(proj)
    st = state.load(root)
    if st["mode"] != "item" or st["item"] != a.id:
        die(f"{a.id} は対応中ではありません。")
    if st["current_phase"] != st["resume_phase"]:
        die(f"まだ戻り先の工程 {st['resume_phase']} まで進んでいません（現在 {st['current_phase']}）。"
            "`scripts/sdlc phase advance` で進めてください。")
    resume = st["resume_phase"]
    bad = gates.prerequisites(root, proj, resume)
    if bad:
        die("人間ゲートが無効な工程があります: " + ", ".join(f"{s['phase']}（{s['reason']}）" for s in bad))
    meta, body = items.load(root, a.id)
    if phase_index(resume) >= phase_index("03-implementation"):
        r = run_shell(proj["commands"]["test"], root)
        if r.returncode != 0:
            die("自動テストが全件成功していません:\n" + (r.stdout + r.stderr)[-3000:])
    if resume == LAST:
        res = testitems.read_results(root)
        pending = [f"{t}: {res.get(t, {}).get('result', '未実施')}" for t in meta.get("retest") or []
                   if t in res and res[t]["result"] not in testitems.PASS_VALUES]
        if pending:
            die("再確認（retest）の TC がまだ OK になっていません（人が結果シートに記入します）:\n  - "
                + "\n  - ".join(pending))
    meta["status"], meta["closed_at"] = "クローズ", state.now()
    items.save(root, a.id, meta, items.log(body, "クローズ"))
    st.update({"mode": "normal", "item": None, "current_phase": resume,
               "step": st.get("resume_step") or "plan", "resume_phase": None, "resume_step": None})
    state.save(root, st)
    print(f"{a.id} をクローズしました。工程 {resume} に戻ります。")


# ------------------------------------------------------------------ main

def build_parser():
    p = argparse.ArgumentParser(prog="scripts/sdlc", description="SDLC ワークフロー（軽量版）状態管理")
    sp = p.add_subparsers(dest="cmd", required=True)

    s = sp.add_parser("status", help="現在の状態と次のアクション")
    s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)
    sp.add_parser("init", help="state/・docs/・ランチャ・CLAUDE.md の import を準備").set_defaults(func=cmd_init)
    x = sp.add_parser("path", help="本体のファイルの実際のパス（プロジェクト優先）")
    x.add_argument("rel", help="例: templates/review.md, checklists/02-design.md, phase-flow.md")
    x.set_defaults(func=cmd_path)
    sp.add_parser("where", help="本体の配置と上書きの状況").set_defaults(func=cmd_where)
    x = sp.add_parser("intake", help="要求ドキュメントを中間形式に変換（工程 01）")
    x.add_argument("inputs", nargs="+")
    x.add_argument("--out")
    x.set_defaults(func=cmd_intake)
    pr = sp.add_parser("project", help="project.yaml").add_subparsers(dest="cmd2", required=True)
    pr.add_parser("check").set_defaults(func=cmd_project_check)

    ph = sp.add_parser("phase", help="工程の操作").add_subparsers(dest="cmd2", required=True)
    ph.add_parser("show").set_defaults(func=cmd_phase_show)
    x = ph.add_parser("step")
    x.add_argument("step", choices=state.STEPS)
    x.set_defaults(func=cmd_phase_step)
    ph.add_parser("advance", help="工程を完了して次へ（人間ゲート、または機械チェック＋レビュー判定）").set_defaults(
        func=cmd_phase_advance)

    gt = sp.add_parser("gate", help="人間ゲートの確認（承認は scripts/approve）").add_subparsers(dest="cmd2", required=True)
    x = gt.add_parser("status")
    x.add_argument("phase", nargs="?")
    x.set_defaults(func=cmd_gate_status)
    x = gt.add_parser("artifacts", help="工程の成果物とハッシュ")
    x.add_argument("phase")
    x.set_defaults(func=cmd_gate_artifacts)
    x = gt.add_parser("check", help="工程に着手可能か")
    x.add_argument("phase")
    x.set_defaults(func=cmd_gate_check)

    tr = sp.add_parser("trace", help="トレーサビリティ").add_subparsers(dest="cmd2", required=True)
    x = tr.add_parser("check")
    x.add_argument("--upto", help="この工程までのルールで検査（既定: 現在工程）")
    x.set_defaults(func=cmd_trace_check)
    for name in ("impact", "up"):
        x = tr.add_parser(name)
        x.add_argument("ids", nargs="+")
        x.set_defaults(func=cmd_trace_walk)
    x = tr.add_parser("matrix")
    x.add_argument("--out")
    x.set_defaults(func=cmd_trace_matrix)

    x = sp.add_parser("check", help="機械チェック（MUST/SHOULD/MAY）")
    x.add_argument("phase", nargs="?", help="既定: 現在工程")
    x.add_argument("--no-report", action="store_true", help="docs/<工程>/checks.md に記録しない")
    x.set_defaults(func=cmd_check)

    ti = sp.add_parser("testitems", help="テスト項目と受入確認の結果シート").add_subparsers(dest="cmd2", required=True)
    ti.add_parser("sheet", help=f"{RESULTS_FILE} を TC 一覧に合わせて作成・更新").set_defaults(func=cmd_ti_sheet)
    x = ti.add_parser("reset", help="再確認が必要な TC を未実施に戻す")
    x.add_argument("tcs", nargs="*")
    x.add_argument("--item", help="票（DEF-xxx / CR-xxx）の retest の TC を対象にする")
    x.add_argument("--reason")
    x.set_defaults(func=cmd_ti_reset)
    x = ti.add_parser("export", help="Excel に出力（任意。人が Excel で記入する場合）")
    x.add_argument("--out", default="docs/04-acceptance/results.xlsx")
    x.set_defaults(func=cmd_ti_export)
    x = ti.add_parser("import", help="Excel に記入された結果を取り込む")
    x.add_argument("file")
    x.set_defaults(func=cmd_ti_import)
    x = ti.add_parser("report", help="仕様ごとの確認状況")
    x.add_argument("--write", action="store_true", help="docs/04-acceptance/report.md に出力")
    x.set_defaults(func=cmd_ti_report)

    dc = sp.add_parser("decision", help="決定事項ログ（state/decisions.md）").add_subparsers(dest="cmd2", required=True)
    x = dc.add_parser("add")
    x.add_argument("text")
    x.add_argument("--phase")
    x.add_argument("--source", help="出典（タスク ID・ゲート・人の指示など）")
    x.set_defaults(func=cmd_decision)
    dc.add_parser("list").set_defaults(func=cmd_decision)
    qs = sp.add_parser("question", help="未解決事項ログ（state/open-questions.md）").add_subparsers(dest="cmd2", required=True)
    x = qs.add_parser("add")
    x.add_argument("text")
    x.add_argument("--priority", default="中", choices=records.PRIORITIES)
    x.add_argument("--phase")
    x.add_argument("--source")
    x.set_defaults(func=cmd_question)
    x = qs.add_parser("answer")
    x.add_argument("id")
    x.add_argument("text")
    x.add_argument("--keep-open", action="store_true", help="回答済みだが未クローズにする")
    x.set_defaults(func=cmd_question)
    x = qs.add_parser("list")
    x.add_argument("--all", action="store_true")
    x.set_defaults(func=cmd_question)

    for kind, help_text, default_from in (("defect", "不具合（仕様どおりに作れていない）", "03"),
                                          ("change", "変更要求（振る舞いを変える・機能を足す）", "01")):
        k = sp.add_parser(kind, help=help_text).add_subparsers(dest="cmd2", required=True)
        x = k.add_parser("new")
        x.add_argument("--title", required=True)
        x.add_argument("--detected-in", help="検出・受付工程（既定: 現在工程）")
        x.add_argument("--severity", default="中", choices=items.SEVERITIES)
        if kind == "defect":
            x.add_argument("--tc", nargs="*", help="NG になった TC（再確認の対象になる）")
        x.set_defaults(func=cmd_item_new, kind=kind)
        k.add_parser("list").set_defaults(func=cmd_item_list, kind=kind)
        x = k.add_parser("start", help="やり直しを開始する")
        x.add_argument("id")
        x.add_argument("--from", dest="from_phase", help=f"やり直しを始める工程（既定: {default_from}）")
        x.set_defaults(func=cmd_item_start, kind=kind)
        x = k.add_parser("close", help="やり直し・再確認が終わったら閉じる")
        x.add_argument("id")
        x.set_defaults(func=cmd_item_close, kind=kind)
    return p


def main(argv=None):
    a = build_parser().parse_args(argv)
    try:
        a.func(a)
    except (ConfigError, FileNotFoundError) as e:
        die(str(e))


if __name__ == "__main__":
    main()
